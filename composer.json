{
    "name": "goodnews/hyperf-passport",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "php",
        "hyperf"
    ],
    "description": "Hyperf Passport provides OAuth2 server support to Hyperf",
    "authors": [
        {
            "name": "goodnews",
            "email": "admin@good.news"
        }
    ],
    "autoload": {
        "psr-4": {
            "Richard\\HyperfPassport\\": "src/"
        },
        "files": [
            "src/helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "HyperfTest\\": "tests"
        }
    },
    "require": {
        "php": ">=8.0",
        "ext-json": "*",
        "96qbhy/hyperf-auth": "^3.1",
        "firebase/php-jwt": "^6.8",
        "goodnews/hyperf-cookie": "*",
        "goodnews/hyperf-encryption": "*",
        "goodnews/hyperf-hashing": "*",
        "hyperf/command": "^3.1",
        "hyperf/contract": "^3.1",
        "hyperf/database": "^3.1",
        "hyperf/db-connection": "^3.1",
        "hyperf/di": "^3.1",
        "hyperf/framework": "^3.1",
        "hyperf/guzzle": "^3.1",
        "hyperf/http-message": "^3.1",
        "hyperf/http-server": "^3.1",
        "hyperf/redis": "^3.1",
        "hyperf/session": "^3.1",
        "hyperf/validation": "^3.1",
        "hyperf/view": "^3.1",
        "hyperf/view-engine": "^3.1",
        "league/oauth2-server": "^9.2",
        "phpseclib/phpseclib": "^3.0"
    },
    "prefer-stable": true,
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "co-phpunit --prepend tests/bootstrap.php -c phpunit.xml --colors=always",
        "analyse": "phpstan analyse --memory-limit 300M -l 0 ./src",
        "cs-fix": "php-cs-fixer fix $1"
    },
    "extra": {
        "hyperf": {
            "config": "Richard\\HyperfPassport\\ConfigProvider"
        }
    }
}
